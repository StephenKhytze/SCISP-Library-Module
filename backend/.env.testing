# Test environment — DOCUMENTATION ONLY, NOT AUTHORITATIVE.
#
# Inside Docker the DB_* values below are IGNORED. Laravel's Dotenv repository is
# built with ->immutable() (Illuminate\Support\Env::getRepository), so it will not
# overwrite a variable that already exists in the real environment — and
# docker-compose exports DB_CONNECTION=mysql / DB_DATABASE=laravel into the
# backend container.
#
# Test isolation is enforced by TWO other mechanisms, not by this file:
#   1. phpunit.xml <env ... force="true"/>  — overrides the container environment
#   2. Tests\TestCase::guardAgainstProtectedDatabase() — hard-aborts if the
#      resolved database is protected (default: `laravel`)
#
# This file exists to signal intent and to help host-side runs where the
# container environment is absent. Do not rely on it as a safety barrier.
#
# See LIBRARY_TASK_TEST_SAFETY.md §1.2 and §3.4.

APP_ENV=testing
DB_CONNECTION=sqlite
DB_DATABASE=:memory:
